{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-intl": "*",
        "alexpechkarev/geometry-library": "1.0.4",
        "bezhansalleh/filament-language-switch": "^3.1",
        "bezhansalleh/filament-shield": "3.1.2",
        "carlos-meneses/laravel-mpdf": "^2.1",
        "cheesegrits/filament-google-maps": "^3.0",
        "christiankuri/laravel-favorite": "^1.4",
        "cknow/laravel-money": "^8.0",
        "cviebrock/eloquent-sluggable": "^12.0",
        "darryldecode/cart": "^4.2",
        "edamov/pushok": "^0.16.0",
        "filament/filament": "^3.2",
        "filament/infolists": "^3.2",
        "filament/spatie-laravel-google-fonts-plugin": "^3.0-stable",
        "filament/spatie-laravel-media-library-plugin": "^3.0-stable",
        "filament/spatie-laravel-settings-plugin": "^3.0-stable",
        "filament/spatie-laravel-translatable-plugin": "^3.2",
        "filament/tables": "^3.2",
        "flowframe/laravel-trend": "^0.4.0",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.2",
        "hasnayeen/themes": "^3.0",
        "jaocero/activity-timeline": "^1.2",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^12.0.0",
        "laravel/sanctum": "^4.2.4",
        "laravel/tinker": "^2.8",
        "livewire/livewire": "^3.4",
        "lorisleiva/laravel-actions": "^2.7",
        "matanyadaev/laravel-eloquent-spatial": "^4.0",
        "mcamara/laravel-localization": "^2.3.0",
        "mpdf/mpdf": "^8.2",
        "myfatoorah/laravel-package": "^2",
        "pxlrbt/filament-activity-log": "^1.1",
        "pxlrbt/filament-excel": "^2.3",
        "saade/filament-fullcalendar": "^3.0",
        "salla/zatca": "^2.0",
        "spatie/laravel-activitylog": "^4.9",
        "spatie/laravel-medialibrary": "^11.4",
        "spatie/laravel-options": "^1.1",
        "spatie/laravel-pdf": "^1.5",
        "spatie/laravel-sluggable": "^3.5",
        "stancl/tenancy": "^3.7",
        "stijnvanouplines/blade-country-flags": "^1.0",
        "tabbyai/laravel": "^2.1",
        "tasawk/api": "1.0.16",
        "theamostafa/laravel-wallet": "^1.0",
        "tightenco/ziggy": "^1.6",
        "wire-elements/modal": "^2.0",
        "ysfkaya/filament-phone-input": "^2.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.14",
        "barryvdh/laravel-ide-helper": "^3.6.1",
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.8.3",
        "phpunit/phpunit": "^11.5.2",
        "spatie/laravel-ignition": "^2.8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "App\\CatalogModule\\": "modules/default/catalog/src",
            "App\\ContentModule\\": "modules/default/content/src",
            "App\\UsersModule\\": "modules/default/users/src",
            "App\\ReportsModule\\": "modules/default/reports/src",
            "App\\UtilitiesModule\\": "modules/default/utilities/src",
            "App\\DefaultPanel\\": "panels/default/src",
            "App\\ProviderPanel\\": "panels/providers/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "panels/default/src/helpers.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "providers": [
                "App\\DefaultPanel\\DefaultPanelServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "producation": {
            "type": "composer",
            "url": "https://gitlab.com/api/v4/group/12160558/-/packages/composer/packages.json"
        }
    }
}
